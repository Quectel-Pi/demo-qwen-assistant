# ─────────────────────────────────────────────────────────────
# 模型权重与官方 SDK（体积过大，不入库）
# ─────────────────────────────────────────────────────────────
# HuggingFace 下载的 Qwen3.5-0.8B-MIT 原始权重（1.7G）
/Qwen3.5-0.8B-MIT/
# Rockchip 官方 rknn-llm SDK（2.6G），按 deploy/README.md §7 自行 clone
/rknn-llm/

# ─────────────────────────────────────────────────────────────
# 转换产物（1.2G）
# ─────────────────────────────────────────────────────────────
/out/*.rkllm
/out/*.rknn
/out/demo_Linux_aarch64/
/out/**/*.onnx
/out/**/*.rknn

# ─────────────────────────────────────────────────────────────
# Python 环境
# ─────────────────────────────────────────────────────────────
/.venv*/
/venv/
/wheelhouse/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────
# 任意位置的二进制模型 / 共享库产物
# ─────────────────────────────────────────────────────────────
*.rkllm
*.rknn
*.onnx
*.so
*.so.*
*.a
*.o
*.dylib
*.dll
*.gguf
*.safetensors
*.bin
*.pth
*.pt
*.ckpt

# 注意：deploy/native/rkllm-service 与 rkllm-service.bak 是 **有意入库** 的
# aarch64 交叉编译产物（各约 140KB），部署归档与回滚需要，属白名单例外：
!/deploy/native/rkllm-service
!/deploy/native/rkllm-service.bak

# ─────────────────────────────────────────────────────────────
# reports/ 体积治理：只保留 *.md / 小体积文本与结构化证据
# 排除截图(bmp/png)、录音(wav)、pid、编译产物等大文件
# ─────────────────────────────────────────────────────────────
/reports/**/*.bmp
/reports/**/*.png
/reports/**/*.jpg
/reports/**/*.jpeg
/reports/**/*.wav
/reports/**/*.mp4
/reports/**/*.pid
/reports/camera-freshness/rkllm-service

# ─────────────────────────────────────────────────────────────
# logs/ 体积治理：单文件 >1MB 的日志/截图不入库
# ─────────────────────────────────────────────────────────────
/logs/**/*.png
/logs/**/*.jpg
/logs/**/*.jpeg
/logs/**/*.bmp
/logs/**/*.wav

# ─────────────────────────────────────────────────────────────
# 编辑器 / 系统垃圾
# ─────────────────────────────────────────────────────────────
.DS_Store
.Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
tags
cscope.*

# ─────────────────────────────────────────────────────────────
# 凭据（绝不入库）
# ─────────────────────────────────────────────────────────────
.env
.env.*
*.env
.netrc
.netrc.*
id_rsa*
id_ed25519*
*.pem
*.key
*.p12
*.pfx
credentials*
*_credentials*
*[Tt]oken*.json
*[Ss]ecret*
.gh/
.ssh/

# 交付用的 git bundle / patch 归档（临时产物，不入库）
/reports/**/*.bundle
/reports/patches/
